# Host que a aplicação usa para alcançar o MySQL
DB_HOST=localhost

# Porta do MySQL
DB_PORT=3306

# Nome do banco/schema dentro do servidor MySQL
DB_NAME=db_products

# Credenciais do banco
DB_USER=user
DB_PASSWORD=uma_senha_exageradamente_forte

# Dialeto SQLAlchemy + driver Python
DB_DRIVER=mysql+pymysql